# ==============================================================================
# LinkFlow — Environment Variables Template
# Copy this file to .env.local and update with your own values.
# DO NOT commit .env or .env.local to version control!
# ==============================================================================

# Database Connection (Neon PostgreSQL or local PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-sample.region.aws.neon.tech/neondb?sslmode=require"
# For local SQLite fallback:
# DATABASE_URL="sqlite:///./linkflow.db"

# Neon Metadata (optional)
NEON_BRANCH=production
NEON_BRANCH_ID=br-sample-id
NEON_FUNCTION_HOST_SUFFIX=.compute.region.aws.neon.tech

# Security & Authentication (minimum 32 characters)
JWT_SECRET_KEY="generate-a-secure-random-32-plus-character-secret-key"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Environment & Application URLs
ENVIRONMENT="development"
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:8000"
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]

# Frontend Next.js Public API URL
NEXT_PUBLIC_API_URL="http://localhost:8000"

# Redis Cache (Optional - set REDIS_ENABLED=false to run without Redis)
REDIS_ENABLED=false
REDIS_URL="redis://localhost:6379/0"
REDIS_CACHE_TTL_SECONDS=86400

# SMTP Email Configuration (Optional - without SMTP, verification tokens print to console)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="noreply@linkflow.local"
SMTP_FROM_NAME="LinkFlow"
SMTP_TLS=true

